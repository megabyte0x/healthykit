# Local Docker defaults. Copy this file to .env before running docker compose.
POSTGRES_DB=healthsync
POSTGRES_USER=healthsync
POSTGRES_PASSWORD=replace-this-local-db-password
POSTGRES_HOST_PORT=15432
API_HOST_PORT=8080

# Generate with: python3 -m backend.scripts.generate_token
API_TOKEN=replace-with-a-long-random-token

# Required by backend config for HMAC hashing hosted ingest and agent tokens.
# Generate with: python3 -m backend.scripts.generate_token
TOKEN_HASH_SECRET=replace-with-a-long-random-hmac-secret

# Hosted provisioning is off for local Docker by default. Enable this only for
# a deployed hosted backend that should create app ingest and read-only agent tokens.
HOSTED_PUBLIC_BASE_URL=https://api.example.com
HOSTED_PROVISIONING_ENABLED=false
